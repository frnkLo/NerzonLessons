FROM eclipse-temurin:17-jdk-alpine

#WORKDIR /app
# рабочая дирректория внутри самого образа

ARG APP_JAR=*.jar
# указываем любой аргумент и его значение. * означает любые символы. К аргументу можно обратиться как к переменной среды ${}
# в таком случае можно написать    COPY ${APP_JAR} app.jar

COPY ${APP_JAR} app.jar
# сначала пишем какой файл копируем, потом В какой образ (название)

ENTRYPOINT ["java", "-jar", "app.jar"]
# Нужно для запуска образа. Получает в кач арг массив строк исполняемых консольных команд

EXPOSE 8080
# указывается порт подключения на котором поднимается приложение

# через терминал можно собрать докер файл. cd - переместиться в папку нужную
# ls - проверить, что есть в папке
#  docker build . - собрать файл. Точка означает что собираем из текущей папки
# docker images показывает все контейнеры и их id
# docker run id образа - запускает конкретный образ
#  docker rmi 18757be4bf9(id образа) удаляет образ
# перед rmi надо удалить контейнер docker rm 18757be4bf9(id образа)
# docker ps посмотреть запущенные контейнеры
# docker-compose logs app(название сервиса) для просмотра логов


# над докером есть docker compose




